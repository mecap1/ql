{
  "name": "mes-cable-desktop",
  "version": "1.0.0",
  "description": "MES Cable - Quản lý sản xuất cáp (bản Desktop)",
  "main": "main.js",
  "author": "Dong Phuong",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dongphuong.mescable",
    "productName": "MES Cable",
    "files": [
      "main.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
